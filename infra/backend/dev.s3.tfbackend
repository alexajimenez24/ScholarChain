# S3 backend settings for the dev environment, shared by every stack. No secrets.
# The key is NOT set here: each stack passes its own
#   -backend-config=key=scholarchain/dev/STACK/terraform.tfstate (STACK = the stack name)
# Locking is S3-native (use_lockfile = true in each stack's backend block); there is no
# DynamoDB lock table.
bucket = "scholarchain-tfstate-30a68cd5"
region = "us-east-2"
