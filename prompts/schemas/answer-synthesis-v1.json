{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "prompts/schemas/answer-synthesis-v1.json",
  "title": "answer-synthesis-v1",
  "description": "The only reply the answer-synthesis-v1 prompt accepts from a model. Every key is required, no other key is allowed (there is no field for reasoning), and the reply is refused when any bound fails. Evidence IDs are checked for existence by the claim verifier, not here.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "summary", "abstain", "abstentionReason", "claims"],
  "properties": {
    "schemaVersion": { "const": "answer-synthesis-v1" },
    "summary": { "type": "string", "minLength": 1, "maxLength": 1500 },
    "abstain": { "type": "boolean" },
    "abstentionReason": { "type": ["string", "null"], "maxLength": 600 },
    "claims": {
      "type": "array",
      "maxItems": 40,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["claimId", "text", "evidenceIds", "uncertainty"],
        "properties": {
          "claimId": { "type": "string", "pattern": "^claim-[0-9]{1,3}$" },
          "text": { "type": "string", "minLength": 1, "maxLength": 500 },
          "evidenceIds": {
            "type": "array",
            "minItems": 1,
            "maxItems": 12,
            "items": { "type": "string", "pattern": "^ev:[a-z_]{2,24}:[0-9a-f]{16}$" }
          },
          "uncertainty": { "type": ["string", "null"], "maxLength": 300 }
        }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "abstain": { "const": true } } },
      "then": { "properties": { "abstentionReason": { "type": "string", "minLength": 1 } } }
    }
  ]
}
