{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "scholarchain/prompts/schemas/query-plan-v1.json",
  "title": "query-plan-v1",
  "description": "Typed QueryPlan (core scholarchain.core.QueryPlan) produced by QueryPlannerAgent planner-v1 and validated by scholarchain.rag.QueryPlanRules before any stage uses it. Operations come only from the plan-operations-v1 allowlist; names, topics, institutions and venues are plain lookup text, never query text; every graph query runs on one configured window chosen from window. Owner: rag-engineer.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "queryId",
    "question",
    "operations",
    "researcherNames",
    "window",
    "topics",
    "institutions",
    "venues",
    "rankingMetric",
    "limit",
    "maxPathDepth",
    "includeSemantic",
    "plannerVersion",
    "provenance"
  ],
  "properties": {
    "schemaVersion": { "const": "query-plan-v1" },
    "queryId": { "type": "string", "minLength": 1 },
    "question": { "type": "string", "minLength": 1, "maxLength": 2000 },
    "operations": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "RESEARCHER_RANKING",
          "MAX_TEAM_SIZE",
          "DIRECT_COAUTHORS",
          "SHORTEST_PATH",
          "COMPONENT_LOOKUP",
          "COMMUNITY_COMPARISON",
          "BRIDGE_RANKING",
          "TEMPORAL_COMPARISON",
          "TOPIC_FILTER",
          "INSTITUTION_FILTER",
          "SEMANTIC_EXPLANATION"
        ]
      }
    },
    "researcherNames": {
      "type": "array",
      "maxItems": 4,
      "items": { "type": "string", "pattern": "^\\p{L}[\\p{L} .'\\-]{0,79}$" }
    },
    "window": {
      "type": "object",
      "additionalProperties": false,
      "required": ["startYear", "endYear"],
      "properties": {
        "startYear": { "type": "integer", "minimum": 1900, "maximum": 2100 },
        "endYear": { "type": "integer", "minimum": 1900, "maximum": 2100 }
      }
    },
    "topics": { "$ref": "#/$defs/filters" },
    "institutions": { "$ref": "#/$defs/filters" },
    "venues": { "$ref": "#/$defs/filters" },
    "rankingMetric": {
      "enum": [
        "PUBLICATION_COUNT",
        "DISTINCT_COAUTHOR_COUNT",
        "TOTAL_COAUTHOR_OCCURRENCES",
        "AVERAGE_COAUTHORS_PER_PAPER",
        "MAXIMUM_COAUTHORS_ON_ONE_PAPER",
        "WEIGHTED_DEGREE",
        "BRIDGE_SCORE",
        "PARTICIPATION_COEFFICIENT",
        "CROSS_COMMUNITY_DEGREE",
        "CORENESS"
      ]
    },
    "limit": { "type": "integer", "minimum": 1, "maximum": 50 },
    "maxPathDepth": { "type": "integer", "minimum": 1, "maximum": 6 },
    "includeSemantic": { "type": "boolean" },
    "plannerVersion": { "const": "planner-v1" },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "sourceRecordId", "snapshot", "runId", "schemaVersion", "policyVersion"],
      "properties": {
        "source": { "const": "SCHOLARCHAIN" },
        "sourceRecordId": { "type": "string", "minLength": 1 },
        "snapshot": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "runId": { "type": "string", "pattern": "^run-[0-9a-f]{16}$" },
        "schemaVersion": { "const": "query-plan-v1" },
        "policyVersion": { "const": "planner-v1" }
      }
    }
  },
  "$defs": {
    "filters": {
      "type": "array",
      "maxItems": 3,
      "items": { "type": "string", "pattern": "^[\\p{L}\\p{N}][\\p{L}\\p{N} .,'&()\\-]{0,79}$" }
    }
  }
}
