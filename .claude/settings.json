{
  "model": "opus",
  "permissions": {
    "allow": [
      "Bash(sbt *)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "Bash(git blame*)",
      "Bash(git ls-files*)",
      "Bash(git rev-parse*)",
      "Bash(git branch --show-current)",
      "Bash(terraform fmt*)",
      "Bash(terraform validate*)",
      "Bash(terraform plan*)",
      "Bash(terraform -chdir=* fmt*)",
      "Bash(terraform -chdir=* validate*)",
      "Bash(terraform -chdir=* plan*)",
      "Bash(bash -n *)",
      "Bash(.claude/hooks/validate-agent-files.sh)",
      "Bash(.agents/render.sh --check)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/*.env)",
      "Read(./.envrc)",
      "Read(**/.envrc)",
      "Read(**/*.tfvars)",
      "Read(**/*.tfvars.json)",
      "Read(./secrets/**)",
      "Read(**/secrets/**)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(**/*.p12)",
      "Read(**/*.pfx)",
      "Read(**/id_rsa*)",
      "Read(**/id_ed25519*)",
      "Read(**/id_ecdsa*)",
      "Read(**/credentials.json)",
      "Read(**/*.tfstate)",
      "Read(**/*.tfstate.*)",
      "Read(~/.aws/credentials)",
      "Read(~/.aws/sso/**)",
      "Read(~/.aws/cli/cache/**)",
      "Read(~/.ssh/**)",
      "Read(~/.claude/.credentials.json)",
      "Read(~/.config/gh/hosts.yml)",
      "Read(~/.codex/auth.json)",
      "Read(~/.netrc)",
      "Edit(./docs/agent-runs/**/human-gate.md)",
      "Write(./docs/agent-runs/**/human-gate.md)",
      "Edit(./datasets/gold/**)",
      "Write(./datasets/gold/**)",
      "Edit(./LICENSE)",
      "Write(./LICENSE)",
      "Edit(./docs/spec/**)",
      "Write(./docs/spec/**)",
      "Bash(terraform apply*)",
      "Bash(terraform destroy*)",
      "Bash(terraform * apply*)",
      "Bash(terraform * destroy*)",
      "Bash(tofu apply*)",
      "Bash(tofu destroy*)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push * --force*)",
      "Bash(git push * -f*)",
      "Bash(git push --force-with-lease*)",
      "Bash(git push * --force-with-lease*)",
      "Bash(git push * +*)",
      "Bash(git commit * --no-verify*)",
      "Bash(git commit -n*)",
      "Bash(git commit * -n*)",
      "Bash(git config core.hooksPath*)",
      "Bash(git * --output*)",
      "Bash(aws s3 rb*)",
      "Bash(aws * s3 rb*)",
      "Bash(aws s3 rm --recursive*)",
      "Bash(aws s3 rm * --recursive*)",
      "Bash(aws * s3 rm * --recursive*)",
      "Bash(aws s3api delete-bucket*)",
      "Bash(aws * s3api delete-bucket*)",
      "Bash(aws s3api delete-objects*)",
      "Bash(aws dynamodb delete-table*)",
      "Bash(aws * dynamodb delete-table*)",
      "Bash(aws dynamodb delete-backup*)",
      "Bash(aws neptune delete-db-cluster*)",
      "Bash(aws * neptune delete-db-cluster*)",
      "Bash(aws neptune delete-db-instance*)",
      "Bash(aws rds delete-db-cluster*)",
      "Bash(aws neptune-graph delete-graph*)",
      "Bash(aws s3vectors delete-vector-bucket*)",
      "Bash(aws * s3vectors delete-vector-bucket*)",
      "Bash(aws s3vectors delete-index*)",
      "Bash(aws * s3vectors delete-index*)",
      "Bash(aws s3vectors delete-vectors*)",
      "Bash(aws ecr delete-repository*)",
      "Bash(aws * ecr delete-repository*)",
      "Bash(aws ecr batch-delete-image*)",
      "Bash(aws kms schedule-key-deletion*)",
      "Bash(aws * kms schedule-key-deletion*)",
      "Bash(aws kms disable-key*)",
      "Bash(aws emr terminate-clusters*)",
      "Bash(aws * emr terminate-clusters*)",
      "Bash(aws ecs delete-service*)",
      "Bash(aws ecs delete-cluster*)",
      "Bash(aws secretsmanager get-secret-value*)",
      "Bash(aws * secretsmanager get-secret-value*)",
      "Bash(aws secretsmanager delete-secret*)",
      "Bash(./scripts/cleanup.sh*)",
      "Bash(scripts/cleanup.sh*)",
      "Bash(bash scripts/cleanup.sh*)",
      "Bash(bash ./scripts/cleanup.sh*)",
      "Bash(sh scripts/cleanup.sh*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|mcp__aws-api__call_aws",
        "hooks": [
          { "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/guard-dangerous.sh", "timeout": 10 }
        ]
      },
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          { "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/guard-ownership.sh", "timeout": 10 }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          { "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/format-scala.sh", "timeout": 120 },
          { "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/validate-agent-files.sh --hook", "timeout": 60 }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "*",
        "hooks": [
          { "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/verify-tests-ran.sh", "timeout": 30 }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "*",
        "hooks": [
          { "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/verify-tests-ran.sh", "timeout": 30 }
        ]
      }
    ]
  }
}
